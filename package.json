{
  "name": "@andreaarrighi/pi-meat",
  "version": "0.3.2",
  "description": "Read code changes without the gristle: navigable reading diffs for Pi, powered by Meat.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "arro000",
    "email": "arrighi000@gmail.com",
    "url": "https://github.com/arro000"
  },
  "homepage": "https://github.com/arro000/pi-meat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arro000/pi-meat.git"
  },
  "bugs": {
    "url": "https://github.com/arro000/pi-meat/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review",
    "git-diff",
    "meat"
  ],
  "files": [
    "extensions",
    "internal",
    "bridge",
    "assets",
    "docs",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "PLAN.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "assets:build": "node scripts/generate-preview.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "check": "tsc --noEmit && go -C bridge test ./... && go -C bridge vet ./...",
    "test": "node --test test/*.test.ts && go -C bridge test ./...",
    "format:check": "node scripts/check-go-format.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm test && npm run check && npm run format:check && npm audit --omit=dev --audit-level=high && npm audit --audit-level=critical && npm run package:smoke",
    "prepublishOnly": "npm run release:check"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-meat/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/arro000/pi-meat/main/assets/pi-meat-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
